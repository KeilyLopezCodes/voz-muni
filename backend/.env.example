PORT=3000
DATABASE_URL=postgres://vozmuni:vozmuni@localhost:5432/vozmuni
DATABASE_URL_TEST=postgres://vozmuni:vozmuni@localhost:5432/vozmuni_test
JWT_SECRET=cambia-este-secreto-de-desarrollo-de-32-chars
NODE_ENV=development
LOGIN_LIMITE_POR_VENTANA=10
# Correo: en desarrollo, una cuenta de https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-de-ethereal@ethereal.email
SMTP_PASS=contraseña-de-ethereal
MAIL_FROM=VozMuni <no-responder@vozmuni.test>
APP_URL=http://localhost:5173
RECUPERACION_LIMITE_POR_VENTANA=5
# Consultas públicas por IP cada 15 minutos en /api/v1/public/tickets/:numero (SPEC 37).
CONSULTA_LIMITE_POR_VENTANA=10
# Adjuntos de las quejas (SPEC 24). Nunca se sirve como carpeta pública; incluirla en el respaldo diario.
ADJUNTOS_DIR=./almacen/adjuntos
# Job de SLA (SPEC 31 y 32): alertas al 80 % del plazo y escalamiento al vencer, con node-cron.
# Sin valor, corre salvo con NODE_ENV=test. SLA_ALERTAS_ACTIVO y SLA_ALERTAS_CRON siguen aceptándose, con un aviso.
SLA_JOB_ACTIVO=true
SLA_JOB_CRON=*/5 * * * *
# Job de correos (SPEC 34): reintenta los correos pendientes de la bandeja de salida (correos_salientes).
# Sin valor, corre cada minuto salvo con NODE_ENV=test.
CORREOS_JOB_ACTIVO=true
CORREOS_JOB_CRON=* * * * *
# Purga diaria de las notificaciones leídas hace más de notificaciones_retencion_dias días (SPEC 36), en hora de
# America/Guatemala. Corre dentro del job de correos: se activa con CORREOS_JOB_ACTIVO.
NOTIFICACIONES_PURGA_CRON=0 3 * * *
