{
  "name": "vozmuni-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de VozMuni",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"for (const dir of ['migrations', 'seeds']) require('node:fs').mkdirSync('dist/infrastructure/database/' + dir, { recursive: true })\"",
    "test": "jest",
    "test:db": "npm run build && node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.db.config.js --runInBand",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate:latest": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile dist/infrastructure/database/knexfile.js migrate:latest",
    "migrate:rollback": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile dist/infrastructure/database/knexfile.js migrate:rollback",
    "seed:run": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile dist/infrastructure/database/knexfile.js seed:run",
    "seed:dev": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile dist/infrastructure/database/knexfile-desarrollo.js seed:run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9"
  }
}
